# Copy to .env for local use. Never put real secrets in this example file.
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL configuration for local development and Docker Compose.
POSTGRES_DB=office_assistant
POSTGRES_USER=office_assistant
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional Docker host port overrides when 5432/6333 are already occupied.
POSTGRES_HOST_PORT=5432
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=2
POSTGRES_POOL_TIMEOUT=10
POSTGRES_POOL_RECYCLE_SECONDS=900
POSTGRES_ECHO=false
DATABASE_CHECK_ON_STARTUP=false
# Startup comparison of this process clock against PostgreSQL now(); past this gap it warns.
CLOCK_DRIFT_WARNING_SECONDS=120

# Telegram Phase 2 configuration.
TELEGRAM_BOT_TOKEN=replace-with-telegram-token
TELEGRAM_ACCESS_PASSWORD=replace-with-access-password
TELEGRAM_POLLING_ENABLED=false

# Experimental read-only Telegram Mini App (HTTPS reverse proxy is mandatory).
# False means no launch button and no Mini App server process.
MINIAPP_ENABLED=false
MINIAPP_PUBLIC_ORIGIN=
MINIAPP_LOCAL_PORT=18791
MINIAPP_REQUEST_TIMEOUT_SECONDS=75

# Approved web-search architecture; implemented in a later phase.
WEB_SEARCH_PRIMARY_PROVIDER=searxng
SEARXNG_BASE_URL=http://searxng:8080
SEARXNG_REQUEST_TIMEOUT_SECONDS=12
SEARXNG_HOST_PORT=18080
SEARXNG_SECRET=replace-with-a-long-random-secret
TAVILY_API_KEY=
TAVILY_REQUEST_TIMEOUT_SECONDS=10
WEB_SEARCH_DEFAULT_LIMIT=6
WEB_SEARCH_MAX_LIMIT=8
WEB_SEARCH_CACHE_TTL_SECONDS=86400
WEB_SEARCH_FRESH_CACHE_TTL_SECONDS=900
WEB_FETCH_TIMEOUT_SECONDS=10
WEB_FETCH_MAX_BYTES=2097152
WEB_FETCH_MAX_REDIRECTS=3
WEB_FETCH_MAX_PAGES=2
WEB_CONTEXT_MAX_TOKENS=3200
EXA_API_KEY=

# Phase 3 local persistent storage and operational safety limits.
FILE_STORAGE_PATH=./var/storage
MAX_UPLOAD_BYTES=26214400
MAX_FILES_PER_PENDING_SESSION=100
PENDING_SESSION_TTL_HOURS=24

# Phase 4 PostgreSQL worker.
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_SECONDS=300
WORKER_MAX_ATTEMPTS=3

# Phase 5 local retrieval projection and model cache.
QDRANT_URL=http://localhost:6333
QDRANT_HOST_PORT=6333
QDRANT_COLLECTION_ALIAS=document_chunks
QDRANT_COLLECTION_NAME=document_chunks_v1
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_PATH=./var/models
EMBEDDING_BATCH_SIZE=32
CHUNKING_VERSION=v1-medium-1800-180
CHUNK_MAX_CHARS=1800
CHUNK_OVERLAP_CHARS=180
RETRIEVAL_DEFAULT_LIMIT=5

# Phase 6 OpenAI answer generation.
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_DEFAULT_MODEL=gpt-6-luna
OPENAI_STRONG_MODEL=gpt-6.1-sol
OPENAI_REQUEST_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=700
# A document image is transcribed by this model, only for the turn that asks about it (ADR 0017).
VISION_MODEL=gpt-4o-mini
VISION_MAX_IMAGE_BYTES=4194304
RAG_RETRIEVAL_LIMIT=5
RAG_MAX_CONTEXT_TOKENS=3200
CHAT_HISTORY_MAX_MESSAGES=6
CHAT_HISTORY_MAX_TOKENS=1200
AI_RATE_LIMIT_PER_MINUTE=12
STRUCTURED_EXTRACTION_ENABLED=true
STRUCTURED_EXTRACTION_MODEL=gpt-6-luna
STRUCTURED_EXTRACTION_MAX_INPUT_CHARS=12000
STRUCTURED_EXTRACTION_MAX_OUTPUT_TOKENS=2200
STRUCTURED_EXTRACTION_BATCH_SIZE=30
STRUCTURED_REVIEW_TTL_HOURS=72
INTERNAL_TOOL_MAX_CALLS=4
INTERNAL_RAG_LIMIT=5
INTERNAL_RAG_MIN_SCORE=0.55
INTERNAL_RAG_IDENTIFIER_MIN_SCORE=0.30
RECENT_SOURCE_CONTEXT_MESSAGES=6
RECENT_SOURCE_CONTEXT_TTL_MINUTES=60
FILE_DELIVERY_MAX_BYTES=26214400
TELEGRAM_MAX_MESSAGE_LENGTH=4096
