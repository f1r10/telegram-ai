# Phase 0 defaults. Copy to .env for local use; never commit .env.
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL configuration for local development and Docker Compose.
POSTGRES_DB=office_assistant
POSTGRES_USER=office_assistant
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=2
POSTGRES_POOL_TIMEOUT=10
POSTGRES_ECHO=false
DATABASE_CHECK_ON_STARTUP=false

# Planned Qdrant configuration (introduced in the RAG phases).
QDRANT_URL=

# Telegram Phase 2 configuration.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ACCESS_PASSWORD=
TELEGRAM_POLLING_ENABLED=false

# Planned OpenAI configuration (introduced after Telegram foundation).
OPENAI_API_KEY=

# Approved web-search architecture; implemented in a later phase.
WEB_SEARCH_PRIMARY_PROVIDER=searxng
SEARXNG_BASE_URL=http://searxng:8080
TAVILY_API_KEY=
EXA_API_KEY=

# Phase 3 local persistent storage and operational safety limits.
FILE_STORAGE_PATH=./var/storage
MAX_UPLOAD_BYTES=26214400
MAX_FILES_PER_PENDING_SESSION=100
PENDING_SESSION_TTL_HOURS=24

