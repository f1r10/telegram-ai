# Phase 0 defaults. Copy to .env for local use; never commit .env.
APP_ENV=development
LOG_LEVEL=INFO

# Planned PostgreSQL configuration (introduced in Phase 2).
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# Planned Qdrant configuration (introduced in the RAG phases).
QDRANT_URL=

# Planned Telegram configuration (introduced in Phase 3).
TELEGRAM_BOT_TOKEN=
BOOTSTRAP_ADMIN_PASSWORD=

# Planned OpenAI configuration (introduced after Telegram foundation).
OPENAI_API_KEY=

# Approved web-search architecture; implemented in a later phase.
WEB_SEARCH_PRIMARY_PROVIDER=searxng
SEARXNG_BASE_URL=http://searxng:8080
TAVILY_API_KEY=
EXA_API_KEY=

# Planned V1 local persistent storage path.
FILE_STORAGE_PATH=./var/storage

