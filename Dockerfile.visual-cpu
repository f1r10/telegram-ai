# Explicit, CPU-only visual-search image. Standard Dockerfile remains unchanged.
# Derived from the office app build to keep the same DB/OCR/Telegram runtime.
FROM ghcr.io/astral-sh/uv:0.12.3 AS uv
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONFAULTHANDLER=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    HF_HUB_DISABLE_TELEMETRY=1

COPY --from=uv /uv /uvx /bin/
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        poppler-utils tesseract-ocr tesseract-ocr-aze tesseract-ocr-eng tesseract-ocr-rus \
    && rm -rf /var/lib/apt/lists/*

# Create the unprivileged user up front and hand over the (still empty) install
# roots once. Every later COPY/install then runs as appuser and writes directly
# into the upper overlay layer. This avoids a final `chown -R appuser /app`,
# which forces an overlayfs copy-up + fsync of the whole multi-GB Torch tree and
# stalls on slow/journal-bound disks (jbd2_log_wait_commit) during the build.
RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /app /data/storage /models/cache \
    && chown appuser:appuser /app /data /data/storage /models /models/cache

WORKDIR /app
USER appuser

COPY --chown=appuser:appuser pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY --chown=appuser:appuser src ./src
COPY --chown=appuser:appuser README.md ./README.md
COPY --chown=appuser:appuser alembic.ini ./alembic.ini
COPY --chown=appuser:appuser migrations ./migrations
RUN uv sync --frozen --no-dev

# The optional model runtime is isolated from the locked base app image.
# Torch and torchvision come from the CPU-only official wheel index.
RUN uv pip install --python /app/.venv/bin/python \
      --index-url https://download.pytorch.org/whl/cpu \
      torch==2.5.1 torchvision==0.20.1 \
    && uv pip install --python /app/.venv/bin/python transformers==4.49.0

# The locked transitive NumPy (>=2.3) ships wheels whose baseline requires
# x86-64-v2 (SSE4.2/POPCNT/SSSE3). The target deployment KVM CPU exposes only the
# x86-64 (v1) baseline, so importing that NumPy aborts with
# "NumPy was built with baseline optimizations: (X86_V2) but your machine doesn't
# support: (X86_V2)" and Torch cannot load. Pin the v1-compatible NumPy that the
# running base app already uses. Kept as a separate layer so the cached Torch
# layer above is reused; the base lock/app image stay untouched.
RUN uv pip install --python /app/.venv/bin/python numpy==2.2.6

RUN mkdir -p /app/var/storage

# --no-sync is required: syncing only the base uv.lock would uninstall the
# intentionally optional Torch/Transformers runtime.
CMD ["uv", "run", "--no-sync", "--no-dev", "python", "-m", "office_assistant.main"]
